{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/rule-pack-schema.json",
  "version": 1,
  "name": "architecture",
  "description": "Layer rules from docs/design.md: which external modules each directory may import.",
  "rules": [
    {
      "id": "ARCH-LAYER-001",
      "kind": "banned-import",
      "files": ["src/core/**"],
      "specifiers": [
        "vscode",
        "assert",
        "async_hooks",
        "buffer",
        "child_process",
        "cluster",
        "console",
        "constants",
        "crypto",
        "dgram",
        "diagnostics_channel",
        "dns",
        "domain",
        "events",
        "fs",
        "http",
        "http2",
        "https",
        "inspector",
        "module",
        "net",
        "os",
        "path",
        "perf_hooks",
        "process",
        "punycode",
        "querystring",
        "readline",
        "repl",
        "stream",
        "string_decoder",
        "test",
        "timers",
        "tls",
        "trace_events",
        "tty",
        "url",
        "util",
        "v8",
        "vm",
        "wasi",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:async_hooks",
        "node:buffer",
        "node:child_process",
        "node:cluster",
        "node:console",
        "node:constants",
        "node:crypto",
        "node:dgram",
        "node:diagnostics_channel",
        "node:dns",
        "node:domain",
        "node:events",
        "node:fs",
        "node:http",
        "node:http2",
        "node:https",
        "node:inspector",
        "node:module",
        "node:net",
        "node:os",
        "node:path",
        "node:perf_hooks",
        "node:process",
        "node:punycode",
        "node:querystring",
        "node:readline",
        "node:repl",
        "node:stream",
        "node:string_decoder",
        "node:test",
        "node:timers",
        "node:tls",
        "node:trace_events",
        "node:tty",
        "node:url",
        "node:util",
        "node:v8",
        "node:vm",
        "node:wasi",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "core must stay pure: do not import VS Code or Node.js built-in modules. Pass time, randomness and I/O in as arguments or services.",
      "severity": "error"
    },
    {
      "id": "ARCH-LAYER-002",
      "kind": "banned-import",
      "files": ["src/services/**"],
      "specifiers": [
        "vscode",
        "assert",
        "async_hooks",
        "buffer",
        "child_process",
        "cluster",
        "console",
        "constants",
        "crypto",
        "dgram",
        "diagnostics_channel",
        "dns",
        "domain",
        "events",
        "fs",
        "http",
        "http2",
        "https",
        "inspector",
        "module",
        "net",
        "os",
        "path",
        "perf_hooks",
        "process",
        "punycode",
        "querystring",
        "readline",
        "repl",
        "stream",
        "string_decoder",
        "test",
        "timers",
        "tls",
        "trace_events",
        "tty",
        "url",
        "util",
        "v8",
        "vm",
        "wasi",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:async_hooks",
        "node:buffer",
        "node:child_process",
        "node:cluster",
        "node:console",
        "node:constants",
        "node:crypto",
        "node:dgram",
        "node:diagnostics_channel",
        "node:dns",
        "node:domain",
        "node:events",
        "node:fs",
        "node:http",
        "node:http2",
        "node:https",
        "node:inspector",
        "node:module",
        "node:net",
        "node:os",
        "node:path",
        "node:perf_hooks",
        "node:process",
        "node:punycode",
        "node:querystring",
        "node:readline",
        "node:repl",
        "node:stream",
        "node:string_decoder",
        "node:test",
        "node:timers",
        "node:tls",
        "node:trace_events",
        "node:tty",
        "node:url",
        "node:util",
        "node:v8",
        "node:vm",
        "node:wasi",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "services describe the steps and know neither VS Code nor the host: keep the I/O in layers/ and talk through Context.Service.",
      "severity": "error"
    },
    {
      "id": "ARCH-LAYER-003",
      "kind": "banned-import",
      "files": ["src/layers/vscode/**", "src/layers/web/**", "src/layers/test/**", "src/entrypoints/shared/**", "src/entrypoints/web/**"],
      "specifiers": [
        "assert",
        "async_hooks",
        "buffer",
        "child_process",
        "cluster",
        "console",
        "constants",
        "crypto",
        "dgram",
        "diagnostics_channel",
        "dns",
        "domain",
        "events",
        "fs",
        "http",
        "http2",
        "https",
        "inspector",
        "module",
        "net",
        "os",
        "path",
        "perf_hooks",
        "process",
        "punycode",
        "querystring",
        "readline",
        "repl",
        "stream",
        "string_decoder",
        "test",
        "timers",
        "tls",
        "trace_events",
        "tty",
        "url",
        "util",
        "v8",
        "vm",
        "wasi",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:async_hooks",
        "node:buffer",
        "node:child_process",
        "node:cluster",
        "node:console",
        "node:constants",
        "node:crypto",
        "node:dgram",
        "node:diagnostics_channel",
        "node:dns",
        "node:domain",
        "node:events",
        "node:fs",
        "node:http",
        "node:http2",
        "node:https",
        "node:inspector",
        "node:module",
        "node:net",
        "node:os",
        "node:path",
        "node:perf_hooks",
        "node:process",
        "node:punycode",
        "node:querystring",
        "node:readline",
        "node:repl",
        "node:stream",
        "node:string_decoder",
        "node:test",
        "node:timers",
        "node:tls",
        "node:trace_events",
        "node:tty",
        "node:url",
        "node:util",
        "node:v8",
        "node:vm",
        "node:wasi",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "this code runs in the web extension host too: do not import Node.js built-in modules. Node-only code belongs in src/layers/node.",
      "severity": "error"
    },
    {
      "id": "ARCH-EXTERNAL-001",
      "kind": "banned-import",
      "files": ["src/core/**"],
      "exclude": ["src/core/**/*.test.ts"],
      "specifiers": [
        "@effect/*",
        "@effect/tsgo",
        "@effect/vitest",
        "@playwright/test",
        "@vitest/coverage-v8",
        "@vscode/test-electron",
        "@vscode/vsce",
        "fallow",
        "lefthook",
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
        "rolldown",
        "rumdl",
        "typescript",
        "vite",
        "vitest",
        "vscode",
        "yaml"
      ],
      "message": "core may depend only on the external package `effect`: move code that needs another package to services/ or layers/.",
      "severity": "error"
    }
  ]
}
