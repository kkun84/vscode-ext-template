{
  "name": "vscode-ext-template",
  "displayName": "%displayName%",
  "version": "0.1.0",
  "private": true,
  "description": "%description%",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkun84/vscode-ext-template"
  },
  "publisher": "kkun84",
  "type": "module",
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.cjs",
  "scripts": {
    "typecheck": "node scripts/typecheck.ts",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check && fallow --fail-on-issues && rumdl check . && node scripts/lint/ja-space/cli.ts && node scripts/lint/no-suppress/cli.ts && node scripts/lint/pnpm-policy/cli.ts",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "mutator",
    "mutation:diff": "node scripts/mutation-diff.ts --skip-without-base",
    "mutation:selftest": "node scripts/mutation-diff-selftest.ts",
    "build": "node scripts/build.ts",
    "budget": "node scripts/budget.ts",
    "package": "node scripts/package.ts && node scripts/check-vsix.ts",
    "test:e2e": "pnpm -s build && playwright test",
    "check-env": "node scripts/check-env.ts",
    "check:vsix": "node scripts/check-vsix.ts",
    "check": "pnpm -s lint && pnpm -s typecheck && pnpm -s test:coverage && pnpm -s build && pnpm -s budget && pnpm -s check:vsix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.5",
    "@mizchi/mutator": "0.5.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/vscode": "1.116.0",
    "@vitest/coverage-v8": "5.1.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "fallow": "3.45.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "rolldown": "1.3.3",
    "rumdl": "0.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "extTemplate.createNote",
        "title": "%command.createNote.title%",
        "category": "%command.category%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "extTemplate.notes.folder": {
          "type": "string",
          "default": "notes",
          "description": "%config.notes.folder.description%"
        },
        "extTemplate.notes.author": {
          "type": "string",
          "default": "",
          "description": "%config.notes.author.description%"
        }
      }
    }
  },
  "engines": {
    "node": "^24.22.1",
    "pnpm": "12.9.0",
    "vscode": "^1.116.0"
  },
  "packageManager": "pnpm@12.9.0"
}
